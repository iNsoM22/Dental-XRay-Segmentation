{
  "version": 2,
  "builds": [
    {
      "src": "/dentai/package.json",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dentai/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/$1"
    }
  ]
}
